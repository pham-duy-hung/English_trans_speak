{
  "manifest_version": 3,
  "name": "English Trans Speak",
  "version": "1.0.0",
  "description": "Dịch đoạn tiếng Anh bằng Azure Translator và đọc bằng Web Speech API.",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.cognitive.microsofttranslator.com/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "English Trans Speak",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options/options.html",
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
